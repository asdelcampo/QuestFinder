# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Both values are public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local only, for `npm run db:seed`. Bypasses row-level security: never prefix with NEXT_PUBLIC_,
# never commit it, never add it to Vercel. Either the new secret key or the legacy service-role key.
SUPABASE_SECRET_KEY=

# The demo login the seed creates and the README documents
DEMO_EMAIL=demo@questfinder.test
DEMO_PASSWORD=
